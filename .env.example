OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Sheets export (Stage 6)
# Local dev: point at the key file on disk.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
# Deployed (Vercel etc.): paste the whole key file's JSON contents instead —
# there's no persistent disk to put a file on. Set this in the host's
# dashboard, not in a committed .env file.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_NAME=Sheet1

# Leads storage + auth both live in the same shared Postgres DB as the other
# project (its User table for auth, this app's own ScrapeLead table for
# pipeline state — see prisma/schema.prisma). NEXTAUTH_SECRET can be its own
# random value, it doesn't need to match theirs (unrelated domains, sessions
# never cross between the two apps).
DATABASE_URL=postgresql://user:password@host:5432/dbname
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
